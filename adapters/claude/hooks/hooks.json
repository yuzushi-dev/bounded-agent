{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bounded-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking bounded runtime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bounded-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking bounded tool policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bounded-hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Reconciling bounded tool output"
          }
        ]
      }
    ]
  }
}
